# AIDI Configuration Example
# Copy this to .env and update values for your environment

# Application
APP_NAME=AIDI
APP_VERSION=0.1.0
DEBUG=false

# Database
DATABASE_URL=postgresql://aidi:aidi_secure_password@localhost:5432/aidi
POSTGRES_PASSWORD=aidi_secure_password

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Models
TEXT_MODEL=ollama/llama3.2:8b
CLASSIFIER_MODEL=ollama/llama3.2:3b

# Routing Thresholds
RULE_CONFIDENCE_THRESHOLD=0.80
LLM_CONFIDENCE_THRESHOLD=0.60

# Tools
TOOLS_ENABLED=true

# API
API_HOST=0.0.0.0
API_PORT=8000
